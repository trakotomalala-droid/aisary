{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Autorisations d'AIsary : choisir un dossier, y écrire les exports, ouvrir des liens",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" },
        { "path": "/Volumes/**" }
      ]
    },
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
